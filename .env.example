HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=false
LIVE_BUFFER_SIZE=5000

MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dht_app
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=dht_monitoring
MYSQL_TABLE=readings

FIREBASE_ENABLED=true
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_FILE=service-account.json
# Alternatively, put the one-line service account JSON in FIREBASE_CREDENTIALS_JSON.
FIREBASE_PATH=readings

DATABASES_REQUIRED=true
